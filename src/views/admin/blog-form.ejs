<%- include('../partials/admin-layout-start') %>
  <div class="admin-topbar">
    <h1 style="font-size:1.5rem;"><%= post ? 'Sửa bài viết' : 'Viết bài mới' %></h1>
  </div>
  <div class="admin-card">
    <form method="POST" action="<%= post ? '/admin/blog/' + post.slug + '/sua' : '/admin/blog/moi' %>">
      <div class="form-group">
        <label for="title">Tiêu đề *</label>
        <input class="form-control" type="text" id="title" name="title" required value="<%= post ? post.title : '' %>" />
      </div>
      <div class="form-group">
        <label for="excerpt">Tóm tắt *</label>
        <textarea class="form-control" id="excerpt" name="excerpt" required><%= post ? post.excerpt : '' %></textarea>
      </div>
      <div class="form-group">
        <label for="content">Nội dung bài viết *</label>
        <textarea class="form-control" id="content" name="content" required style="min-height:220px;"><%= post ? post.content : '' %></textarea>
      </div>
      <% if (!post) { %>
      <div class="form-group">
        <label for="author">Tác giả</label>
        <input class="form-control" type="text" id="author" name="author" placeholder="Tan Loc Advertising" />
      </div>
      <% } %>
      <button type="submit" class="btn btn-gold">Lưu bài viết</button>
    </form>
  </div>
<%- include('../partials/admin-layout-end') %>
