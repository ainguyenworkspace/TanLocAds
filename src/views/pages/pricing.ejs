<!DOCTYPE html>
<html lang="vi">
<head>
<%- include('../partials/head') %>
</head>
<body>
<%- include('../partials/header') %>

<div class="page-header">
  <div class="container">
    <div class="breadcrumb"><a href="/">Trang chủ</a> / Bảng giá</div>
    <h1>Bảng giá tham khảo</h1>
    <p>Giá thực tế có thể thay đổi tùy theo chất liệu, kích thước và độ phức tạp. Liên hệ để nhận báo giá chính xác nhất.</p>
  </div>
</div>

<section class="section-sm">
  <div class="container">
    <div class="admin-card" id="calc">
      <h2 style="margin-bottom:6px;">Tính giá ước tính nhanh</h2>
      <p style="color:var(--color-ink-soft); margin-bottom:20px;">Chọn dịch vụ và nhập diện tích để xem mức giá tham khảo. Đây là ước tính sơ bộ, chưa bao gồm chi phí thiết kế riêng và vận chuyển xa.</p>
      <div class="grid grid-3" style="align-items:end; gap:16px;">
        <div class="form-group" style="margin-bottom:0;">
          <label for="calc-service">Dịch vụ</label>
          <select class="form-control" id="calc-service">
            <% pricing.forEach(function(p, i) { %>
              <option value="<%= p.priceFrom.replace(/\./g, '') %>" data-unit="<%= p.unit %>"><%= p.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group" style="margin-bottom:0;">
          <label for="calc-area">Diện tích (m²)</label>
          <input class="form-control" id="calc-area" type="number" min="0.1" step="0.1" placeholder="VD: 3" />
        </div>
        <button type="button" id="calc-btn" class="btn btn-gold">Tính giá</button>
      </div>
      <p id="calc-result" style="margin-top:16px; font-weight:700; font-size:1.1rem; display:none;"></p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="grid grid-3">
      <% pricing.forEach(function(p, i) { %>
        <div class="price-card <%= i === 1 ? 'featured' : '' %>">
          <% if (p.image) { %>
            <div class="portfolio-thumb" style="border-radius: var(--radius-sm); margin-bottom:16px;">
              <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy" />
            </div>
          <% } %>
          <h3><%= p.name %></h3>
          <div class="price-amount">Từ <%= p.priceFrom %>đ <span>/ <%= p.unit %></span></div>
          <ul class="price-features">
            <% p.features.forEach(function(f) { %>
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span><%= f %></span>
              </li>
            <% }) %>
          </ul>
          <a href="/lien-he" class="btn btn-primary btn-block">Nhận báo giá chi tiết</a>
        </div>
      <% }) %>
    </div>
    <p class="text-center" style="margin-top:28px; color:var(--color-muted); font-size:0.85rem;">*Bảng giá mang tính chất tham khảo, chưa bao gồm chi phí thiết kế riêng (nếu có) và vận chuyển xa.</p>
  </div>
</section>

<section class="section" style="background:var(--color-cream);">
  <div class="container">
    <div class="cta-banner">
      <h2>Nhận báo giá chính xác trong 24h</h2>
      <p>Gửi thông tin dự án, chúng tôi sẽ liên hệ tư vấn và báo giá miễn phí.</p>
      <div class="hero-ctas">
        <a href="/lien-he" class="btn btn-gold">Yêu cầu báo giá</a>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var btn = document.getElementById('calc-btn');
    var result = document.getElementById('calc-result');
    var serviceSelect = document.getElementById('calc-service');
    var areaInput = document.getElementById('calc-area');

    btn.addEventListener('click', function () {
      var price = parseFloat(serviceSelect.value);
      var area = parseFloat(areaInput.value);
      var unit = serviceSelect.options[serviceSelect.selectedIndex].dataset.unit;
      var serviceName = serviceSelect.options[serviceSelect.selectedIndex].text;

      if (!area || area <= 0) {
        result.style.display = 'block';
        result.style.color = 'var(--color-danger)';
        result.textContent = 'Vui lòng nhập diện tích hợp lệ.';
        return;
      }

      var total = price * area;
      result.style.display = 'block';
      result.style.color = 'var(--color-ink)';
      result.textContent = serviceName + ' (' + area + ' ' + unit + '): ước tính từ ' + total.toLocaleString('vi-VN') + 'đ';
    });
  })();
</script>

<%- include('../partials/footer') %>
</body>
</html>
