<!DOCTYPE html>
<html lang="vi">
<head>
<%- include('../partials/head') %>
</head>
<body>
<%- include('../partials/header') %>

<div class="page-header">
  <div class="container">
    <div class="breadcrumb"><a href="/">Trang chủ</a> / Liên hệ</div>
    <h1>Liên hệ với chúng tôi</h1>
    <p>Gửi yêu cầu tư vấn, chúng tôi sẽ phản hồi trong vòng 24 giờ.</p>
  </div>
</div>

<section class="section">
  <div class="container grid grid-2">
    <div class="admin-card">
      <h2>Gửi yêu cầu tư vấn</h2>

      <% if (sent) { %>
        <div class="alert alert-success">Cảm ơn bạn! Yêu cầu đã được gửi thành công, chúng tôi sẽ liên hệ sớm nhất.</div>
      <% } %>
      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/lien-he" novalidate>
        <input type="text" name="website" class="honeypot" tabindex="-1" autocomplete="off" />
        <div class="form-group">
          <label for="name">Họ và tên *</label>
          <input class="form-control" type="text" id="name" name="name" required value="<%= old.name || '' %>" />
        </div>
        <div class="form-group">
          <label for="phone">Số điện thoại *</label>
          <input class="form-control" type="tel" id="phone" name="phone" required value="<%= old.phone || '' %>" />
        </div>
        <div class="form-group">
          <label for="email">Email</label>
          <input class="form-control" type="email" id="email" name="email" value="<%= old.email || '' %>" />
        </div>
        <div class="form-group">
          <label for="message">Nội dung yêu cầu *</label>
          <textarea class="form-control" id="message" name="message" required><%= old.message || '' %></textarea>
        </div>
        <button type="submit" class="btn btn-gold btn-block">Gửi yêu cầu</button>
      </form>
    </div>

    <div>
      <h2>Thông tin liên hệ</h2>
      <ul class="footer-contact" style="color:var(--color-ink-soft);">
        <li style="margin-bottom:16px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span><%= company.address %></span>
        </li>
        <li style="margin-bottom:16px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <a href="tel:<%= company.phone.replace(/\D/g, '') %>"><%= company.phone %></a>
        </li>
        <li style="margin-bottom:16px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <a href="mailto:<%= company.email %>"><%= company.email %></a>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span><%= company.workingHours %></span>
        </li>
      </ul>

      <div class="hero-visual" style="margin-top:24px; aspect-ratio: unset;">
        <iframe
          title="Bản đồ"
          src="https://www.google.com/maps?q=<%= encodeURIComponent(company.address) %>&output=embed"
          width="100%" height="320" style="border:0;" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
</body>
</html>
