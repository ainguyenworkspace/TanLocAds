<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<meta name="description" content="<%= typeof description !== 'undefined' ? description : '' %>" />
<link rel="icon" href="/images/brand/logo.png" />
<link rel="stylesheet" href="/css/style.css" />
<meta property="og:title" content="<%= title %>" />
<meta property="og:description" content="<%= typeof description !== 'undefined' ? description : '' %>" />
<meta property="og:image" content="/images/brand/logo.png" />
<meta property="og:type" content="website" />
