<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">
          <img src="/images/brand/logo.png" alt="<%= company.brandName %>" />
        </div>
        <p><%= company.legalName %></p>
        <p style="font-size:0.85rem;"><%= company.slogan %> - <%= company.tagline %></p>
      </div>

      <div>
        <h4>Liên kết</h4>
        <ul>
          <li><a href="/gioi-thieu">Giới thiệu</a></li>
          <li><a href="/dich-vu">Dịch vụ</a></li>
          <li><a href="/bang-gia">Bảng giá</a></li>
          <li><a href="/du-an">Dự án</a></li>
        </ul>
      </div>

      <div>
        <h4>Hỗ trợ</h4>
        <ul>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/tuyen-dung">Tuyển dụng</a></li>
          <li><a href="/lien-he">Liên hệ</a></li>
        </ul>
      </div>

      <div>
        <h4>Liên hệ</h4>
        <ul class="footer-contact">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span><%= company.address %></span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href="tel:<%= company.phone.replace(/\D/g, '') %>"><%= company.phone %></a>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <a href="mailto:<%= company.email %>"><%= company.email %></a>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span><%= company.workingHours %></span>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      &copy; <%= new Date().getFullYear() %> <%= company.legalName %>. Đã đăng ký bản quyền.
    </div>
  </div>
</footer>

<div class="floating-actions">
  <a class="floating-btn zalo" href="https://zalo.me/<%= company.zalo %>" aria-label="Nhắn Zalo" target="_blank" rel="noopener">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
  </a>
  <a class="floating-btn phone" href="tel:<%= company.phone.replace(/\D/g, '') %>" aria-label="Gọi điện">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
  </a>
</div>

<script src="/js/main.js"></script>
